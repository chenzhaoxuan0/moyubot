{
  "name": "agent-workbench-prototype",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "UI/UX 原型壳：一个界面，两种视图，多家工具平等切换。此阶段不含任何厂商代码。",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "check:models": "node --experimental-strip-types scripts/check-models.ts",
    "check:sidepane": "node --experimental-strip-types scripts/check-sidepane.ts",
    "check:avatar-accent": "node --experimental-strip-types scripts/check-avatar-accent.ts",
    "check": "pnpm check:models && pnpm check:sidepane && pnpm check:avatar-accent && pnpm check:git-names",
    "check:bridge": "node --experimental-strip-types scripts/check-daemon-bridge.ts",
    "check:git-names": "node --experimental-strip-types scripts/check-git-names.ts"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.22",
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/xterm": "^6.0.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "pinyin-match": "^1.2.10",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-resizable-panels": "^4.13.3",
    "shiki": "^4.5.0",
    "streamdown": "^2.7.0",
    "tailwind-merge": "^3.0.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.0",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
